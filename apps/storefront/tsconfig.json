{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "typeRoots": [
      "./src/types/index.d.ts"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/not-found.js",
    "../../lib/components/src/major/wrapper/DrawerWrapper.tsx",
    "../../lib/components/src/major/wrapper/Overlay.tsx",
    "../../lib/components/src/utils/navigation.ts",
    "../../lib/components/src/utils/getOrCreateDeviceId.ts",
    "src/services/mixpanel/setStoreVisitors.ts"
, "../../lib/components/src/services/mixpanel/storeFront/setLoopVisitor.ts", "../../lib/components/src/utils/domain.ts"  ],
  "exclude": [
    "node_modules"
  ]
}